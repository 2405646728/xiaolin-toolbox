{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小林的工具箱",
  "version": "1.0.0",
  "identifier": "com.xiaolin.toolbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "小林的工具箱",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "XiaoLin Studio",
    "copyright": "Copyright © 2026 XiaoLin Studio",
    "category": "Utility",
    "shortDescription": "跨平台系统优化集成工具箱",
    "longDescription": "小林的工具箱 — 基于 Tauri 2.0 构建的跨平台系统优化集成应用，集成了垃圾清理、隐私清理、网络优化、安全扫描、OPPO Find X8s 专属定制等功能，采用 iOS 26 液态玻璃设计语言。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
