{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小林 AI",
  "version": "1.1.3",
  "identifier": "com.xiaolin.ai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "小林 AI",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "XiaoLin Studio",
    "copyright": "Copyright © 2026 XiaoLin Studio",
    "category": "Utility",
    "shortDescription": "对话型 AI 助手",
    "longDescription": "小林 AI — 基于 Tauri 2.0 构建的对话型 AI 助手，集成 70+ 实用功能，覆盖系统控制、快捷启动、网络工具、编码转换、文本处理等，采用 iOS 26 液态玻璃设计语言。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEN0Y3MUJEQjVBMTk1OUIKUldTYmxhRzF2WEYvemVNcG1FSEN5VWZ6WCt6WmZWRXdzOFlUK2QxbkRaSG9OcUwwV0xBTmtiTUsK",
      "endpoints": [
        "https://github.com/2405646728/xiaolin-toolbox/releases/latest/download/latest.json"
      ]
    }
  }
}
